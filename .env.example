# Root environment configuration for MPLADS Sentinel
# This file is a template. Copy to .env and replace values for your environment.

NODE_ENV=development
PORT=4000
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d

# Backend
BACKEND_PORT=4000
BACKEND_API_BASE_URL=http://localhost:4000/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mplads_sentinel

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=MPLADS Sentinel

# Optional storage / analytics providers
# GEMINI_API_KEY=your_key_here
# REDIS_URL=redis://localhost:6379

# Data source configuration
OFFICIAL_DATA_SOURCE=OFFICIAL_MPLADS
SYNTHETIC_DATA_SOURCE=SYNTHETIC_DEMO
